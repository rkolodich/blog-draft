{
	"name": "kolodich-blog",
	"version": "1.0.0",
	"description": "Blog based on eleventy",
	"author": "Ruslan Kolodich <rk0l0dic4rus@gmail.com> (https://github.com/rkolodich)",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"dev": "eleventy --serve --incremental --port=8800",
		"build": "cross-env NODE_ENV=prod eleventy --incremental",
		"fix": "prettier . --write"
	},
	"keywords": [
		"Eleventy",
		"Blog"
	],
	"license": "MIT",
	"packageManager": "pnpm@^10",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.0",
		"autoprefixer": "^10.4.21",
		"cross-env": "^7.0.3",
		"esbuild": "^0.25.5",
		"fast-glob": "^3.3.3",
		"html-minifier-terser": "^7.2.0",
		"postcss": "^8.5.6",
		"postcss-csso": "^6.0.1",
		"prettier": "^3.6.2",
		"prettier-plugin-jinja-template": "^2.1.0",
		"sass": "^1.89.2"
	},
	"dependencies": {
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.1",
		"@comtext/markdown-it-blockquote-cite": "^0.1.0",
		"@myxotod/eleventy-plugin-readingtime": "^2.0.0",
		"dayjs": "^1.11.13",
		"markdown-it": "^14.1.0",
		"markdown-it-image-figures": "^2.1.1"
	}
}
